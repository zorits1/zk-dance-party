{
  "rules": {
    "songs": {
      ".read": true,
      ".indexOn": [
        "dancers",
        "plays"
      ],
      "$id": {
        ".write": "$id.length === 11",
        ".validate": "newData.hasChildren(['title', 'plays', 'dancers'])",
        "title": {
          ".validate": "newData.isString() && newData.val().length <= 150"
        },
        "style": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "bpm": {
          ".validate": "newData.isNumber() && newData.val() >= 60 && newData.val() <= 200"
        },
        "t0": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 10"
        },
        "energy": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3"
        },
        "dur": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 7200"
        },
        "updated": {
          ".validate": "newData.isNumber()"
        },
        "plays": {
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        },
        "dancers": {
          ".validate": "newData.isNumber() && newData.val() > (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 4"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "country": {
      ".read": true,
      "$cc": {
        ".indexOn": [
          "dancers",
          "plays"
        ],
        "$id": {
          ".write": "$cc.length === 2 && $id.length === 11",
          ".validate": "newData.hasChildren(['title', 'plays', 'dancers'])",
          "title": {
            ".validate": "newData.isString() && newData.val().length <= 150"
          },
          "style": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "bpm": {
            ".validate": "newData.isNumber() && newData.val() >= 60 && newData.val() <= 200"
          },
          "updated": {
            ".validate": "newData.isNumber()"
          },
          "plays": {
            ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
          },
          "dancers": {
            ".validate": "newData.isNumber() && newData.val() > (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 4"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "moves": {
      ".read": true,
      "$id": {
        ".write": "!data.exists() && $id.length <= 40",
        ".validate": "newData.hasChildren(['n', 'lv', 'st', 'e', 'k'])",
        "n": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "lv": {
          ".validate": "newData.isString() && newData.val().length <= 6"
        },
        "st": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "e": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3"
        },
        "src": {
          ".validate": "newData.isString() && newData.val().length <= 11"
        },
        "k": {
          ".validate": "newData.hasChildren()"
        },
        "$other": {
          ".validate": false
        },
        "j3": {
          ".validate": "newData.isString() && newData.val().length < 20000"
        }
      }
    },
    "relay": {
      "$room": {
        ".read": "$room.length === 4",
        ".write": "$room.length === 4",
        "tv": {
          ".validate": "newData.hasChildren(['at'])"
        },
        "toTV": {
          "$msg": {
            ".validate": "newData.hasChildren(['m']) && newData.child('m').isString() && newData.child('m').val().length < 1500000"
          }
        },
        "toPhone": {
          "$msg": {
            ".validate": "newData.hasChildren(['m']) && newData.child('m').isString() && newData.child('m').val().length < 1500000"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
